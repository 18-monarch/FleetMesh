# Backend only. Never put database URLs or SESSION_SECRET in Vercel/frontend variables.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.neon.tech/fleetmesh?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.neon.tech/fleetmesh?sslmode=require
SESSION_SECRET=GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
ALLOWED_ORIGINS=https://YOUR_FRONTEND.vercel.app
PORT=10000
MAX_ACTIVE_RUNS=2
